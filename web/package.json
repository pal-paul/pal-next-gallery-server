{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mobile:ios": "open ios/App/App.xcodeproj",
    "mobile:ios:simulator": "../scripts/deploy.sh simulator",
    "mobile:ios:iphone": "../scripts/deploy.sh iphone",
    "mobile:ios:all": "../scripts/deploy.sh all",
    "mobile:android": "open -a 'Android Studio' android",
    "mobile:android:build": "JAVA_HOME=\"$(if command -v brew >/dev/null && brew --prefix openjdk@21 >/dev/null 2>&1; then printf '%s/libexec/openjdk.jdk/Contents/Home' \"$(brew --prefix openjdk@21)\"; else /usr/libexec/java_home -v 21; fi)\" ./android/gradlew -p android assembleDebug"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
