# Go builder image used by the multi-stage Docker build.
GO_IMAGE=golang:1.27.1-alpine
# Node builder image used for the gallery production build.
NODE_IMAGE=node:24-alpine
# Minimal runtime image containing the compiled application.
RUNTIME_IMAGE=alpine:3.23
# PostgreSQL image used by the local Compose stack.
POSTGRES_IMAGE=postgres:17-alpine
# Published gallery server image used by Compose.
SERVER_IMAGE=ghcr.io/pal-paul/pal-next-gallery-server:latest
# Docker build context, relative to build/compose.yaml.
BUILD_CONTEXT=..
# Dockerfile path, relative to the build context.
DOCKERFILE_PATH=build/Dockerfile

# PostgreSQL database created when the container starts.
POSTGRES_DB=uploader
# PostgreSQL application user.
POSTGRES_USER=uploader
# PostgreSQL password; replace this value for your environment.
POSTGRES_PASSWORD=change-me
# PostgreSQL Compose service hostname used inside the Docker network.
POSTGRES_HOST=postgres
# PostgreSQL port exposed on the host machine.
POSTGRES_HOST_PORT=5432
# PostgreSQL port used inside the Docker network.
POSTGRES_CONTAINER_PORT=5432
# Persistent PostgreSQL data directory inside the container.
POSTGRES_DATA_DIR=/var/lib/postgresql/data
# PostgreSQL TLS mode for the application connection.
POSTGRES_SSLMODE=disable
# Delay between PostgreSQL health checks.
POSTGRES_HEALTH_INTERVAL=5s
# Maximum duration allowed for each PostgreSQL health check.
POSTGRES_HEALTH_TIMEOUT=3s
# Failed health checks allowed before PostgreSQL is unhealthy.
POSTGRES_HEALTH_RETRIES=10
# Docker Compose restart policy for the server service.
COMPOSE_RESTART_POLICY=unless-stopped
# Docker JSON log rotation for both services.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Synology bind-mount directories used by build/compose.synology.yaml.
NAS_POSTGRES_PATH=/volume1/docker/next-gallery-server/postgres
NAS_MEDIA_PATH=/volume1/media/gallery
NAS_UPLOAD_TMP_PATH=/volume1/media/tmp

# Gin runtime mode: debug, release, or test.
ENV_GIN_MODE=release
# HTTP port used by the server container and exposed on the host.
ENV_PORT=8081
# Bootstrap username used only to authorize the one-time /setup form.
ENV_ADMIN_USERNAME=admin
# Bootstrap password used only by /setup; must contain at least 12 characters.
ENV_ADMIN_PASSWORD=change-me-at-least-12-characters
# Serve the administrator-only /admin/config HTML page: YES or NO.
ENV_ADMIN_CONFIG=YES
ENV_WEB_DIR=./web/dist
# PostgreSQL connection URL assembled from the settings above.
ENV_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_CONTAINER_PORT}/${POSTGRES_DB}?sslmode=${POSTGRES_SSLMODE}
# Directory where completed media files are stored inside the container.
ENV_MEDIA_DIR=/data/medias
# Directory where upload metadata and incomplete chunks are stored.
ENV_TMP_DIR=/data/tmp
# Maximum accepted media size in bytes (100 GiB in this example).
ENV_MAX_UPLOAD_SIZE_BYTES=107374182400
# Maximum declared bytes across one user's incomplete uploads.
ENV_MAX_PENDING_UPLOAD_BYTES_PER_USER=107374182400
# Maximum completed and pending bytes retained for one user (1 TiB).
ENV_MAX_STORAGE_BYTES_PER_USER=1099511627776
# Bytes kept free on temporary and media filesystems (2 GiB).
ENV_MIN_DISK_FREE_BYTES=2147483648
# Maximum incomplete upload sessions allowed per user.
ENV_MAX_ACTIVE_UPLOADS_PER_USER=10
# Maximum time allowed to receive one request, including an 8 MiB chunk body.
ENV_HTTP_READ_TIMEOUT=5m
# Frequency for expired authentication and abandoned-upload cleanup.
ENV_CLEANUP_INTERVAL=1h
# Age after which an incomplete upload is removed (7 days).
ENV_UPLOAD_RETENTION=168h
# Comma-separated browser origins allowed to call the API.
ENV_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Synology reverse-proxy source IP/CIDR. Leave empty when exposing the app directly.
ENV_TRUSTED_PROXIES=
# TOTP issuer displayed by authenticator applications.
ENV_ISSUER=local.next-gallery-server
# Local clock time for nightly automatic album reconciliation.
ENV_AUTO_ALBUM_RUN_AT=02:00
# IANA timezone used by the automatic album schedule.
ENV_AUTO_ALBUM_TIMEZONE=Europe/Stockholm
# Frequency for background Moment generation.
ENV_MOMENTS_INTERVAL=168h
# Optional Ollama endpoint used to generate moment titles and descriptions.
ENV_MOMENTS_QWEN_URL=http://host.docker.internal:11434
# Ollama vision model used for moment metadata enrichment.
ENV_MOMENTS_QWEN_MODEL=qwen3-vl:4b

ENV_TEST_USER=palash
ENV_TEST_PASSWORD=admin@123456
